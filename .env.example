# Copiá este archivo a .env.local y completá los valores. .env.local no se commitea.

# Pooler de Supabase en modo transaction (puerto 6543). Lo usa la app.
# Para desarrollar sin Supabase con la base local (npm run db:local):
# postgres://postgres:postgres@127.0.0.1:5433/postgres?max=1
DATABASE_URL=

# Conexión directa o pooler en modo session (puerto 5432). La usa drizzle-kit para migrar.
DATABASE_URL_MIGRACIONES=

# Clave única para entrar al panel web.
CLAVE_PANEL=

# Firma la cookie de sesión del panel. Mínimo 32 caracteres aleatorios.
# Se genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRETO_SESION=

# Diferencia máxima, en pesos, entre lo cobrado en efectivo y el catálogo que se toma como redondeo.
TOPE_REDONDEO_EFECTIVO=1000
